# Local tools and user settings
.DS_Store
Thumbs.db
desktop.ini
.metadata/
.vscode/
.idea/
__pycache__/
*.pyc
*.swp
*~
.env
.env.*
!.env.example

# TD implementation results; keep all production RTL, IP and ROM inputs.
/FPGA/td_project/*_Runs/
/FPGA/td_project/log/

# Firmware build output (not IP/ROM initialization files).
/FDWork/ph1p35_hello/build/
/FDWork/ph1p35_hello/Debug/
/FDWork/ph1p35_hello/Release/
/FDWork/MCU_startup/build/
/FDWork/MCU_startup/Debug/
/FDWork/MCU_startup/Release/

# FD files containing machine-specific paths: generated by tools/prepare-local.ps1.
/FDWork/ph1p35_hello/.fd/project.json
/FDWork/MCU_startup/.fd/project.json
/FDWork/ph1p35_hello/final_current_0x70ff.launch

# Simulation compiler libraries, result logs and generated screen dumps.
/FPGA/sim/current/*_work/
/FPGA/sim/current/runs/
/FPGA/sim/current/*.log
/FPGA/sim/current/menu_*.hex
/FPGA/sim/current/menu_vectors.txt
/FPGA/sim/current/*.wlf
/FPGA/sim/current/*.vcd
/FPGA/sim/current/transcript
/FPGA/sim/transcript

# Local historical manifests and board investigation evidence, not fresh checks.
/package_manifest.json
/FPGA/sim/current/*baseline*.json
/FPGA/sim/current/project_manifest.json
/FPGA/sim/current/verification_summary.json
/FPGA/sim/current/board_mode_readonly.cfg

# User-selected release bundles, kept local until uploaded to a GitHub Release.
/release-local/
